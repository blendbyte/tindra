# ── Core ──────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://tindra:tindra@localhost:5432/tindra?sslmode=disable
PUBLIC_URL=https://tindra.example.com
# TCP port (default) or Unix socket
# BIND_ADDR=unix:/run/tindra/tindra.sock
BIND_ADDR=:8080
# Unix socket permissions (octal). Default 0660 = owner + group only.
# Set to 0666 when bind-mounting the socket out of a Docker container so the
# host nginx can connect without needing UID/GID alignment.
# In a docker-compose environment block you MUST quote it, otherwise YAML reads
# 0666 as the octal integer 438 and passes the wrong value: SOCKET_MODE: "0666"
# SOCKET_MODE=0666
# Must be writable by the application user. The Docker image uses UID/GID 65532.
# Fresh named volumes are initialized automatically; bind mounts need matching ownership.
DATA_DIR=/data
LOG_LEVEL=info
LOG_FORMAT=

# Set to "true" in production when serving over HTTPS
COOKIE_SECURE=false

# Set when the API and UI are served from different origins
CORS_ORIGIN=

# ── Retention and limits ──────────────────────────────────────────────────────
# Days to keep events and issues; 0 = keep forever
RETENTION_DAYS=90

# 0 = unlimited
PROJECT_LIMIT=0
EVENT_LIMIT=0
USER_LIMIT=0

# Max log rows retained instance-wide (globally oldest are dropped first when exceeded); 0 = no cap
LOG_ROW_LIMIT=0

# Max transaction rows retained instance-wide (globally oldest are dropped first when exceeded); 0 = no cap
# Deleting a transaction also removes its child spans.
TX_ROW_LIMIT=0

# ── Rate limiting (0 = disabled) ──────────────────────────────────────────────
# Max login attempts per IP per 15 minutes
# Password-reset requests have a separate per-IP budget using this same limit.
RATE_LIMIT_LOGIN=10

# Max envelope POSTs per project per minute
RATE_LIMIT_ENVELOPE=300

# ── Networking ────────────────────────────────────────────────────────────────
# Comma-separated trusted proxy IPs or CIDRs, e.g. 10.0.0.10,10.0.0.11
# Include only actual proxies: forwarded hops are checked from right to left.
# Leave empty when Tindra is directly internet-facing.
TRUSTED_PROXIES=

# Allow webhook and Slack/Discord alert delivery to private/internal IP addresses
WEBHOOK_ALLOW_PRIVATE_IPS=false

# Allow uptime probes to reach private/internal addresses (disabled by default).
# Source-code enrichment always blocks internal destinations.
UPTIME_ALLOW_PRIVATE_IPS=false

# Set to "false" to allow users to access the app without setting up MFA.
# When true (default), API access is restricted until MFA enrollment completes.
# Enrolled users must verify their local MFA factor after password or SSO login.
REQUIRE_MFA=true

# ── Internal ──────────────────────────────────────────────────────────────────
# Secret bearer token for GET /api/stats and /metrics; leave empty to disable both
STATS_API_KEY=

# Set to "true" to disable the periodic check for new Tindra versions.
# When enabled (default), the server contacts https://www.tindra.sh/version-update-check
# every 6 hours and shows a notice in the Settings > Overview panel.
DISABLE_VERSION_CHECK=false

# Shows a billing portal link in settings and event-limit banners
BILLING_URL=

# ── Email alerts ──────────────────────────────────────────────────────────────
# Supported providers: smtp | postmark | brevo | lettermint | ahasend | cloudflare
# Leave EMAIL_PROVIDER unset to disable email alerts entirely.
# EMAIL_PROVIDER=
# EMAIL_FROM=alerts@example.com
# EMAIL_FROM_NAME=Tindra Alerts

# SMTP
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Postmark
# POSTMARK_API_KEY=

# Brevo
# BREVO_API_KEY=

# Lettermint
# LETTERMINT_API_KEY=

# Ahasend
# AHASEND_API_KEY=

# Cloudflare Email Routing
# CLOUDFLARE_EMAIL_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# ── OAuth / SSO ───────────────────────────────────────────────────────────────
# SSO accepts existing users or an unexpired invitation matching the provider email.
# Invite new users in Settings > Team, then have them sign in with SSO.
# New SSO accounts count toward USER_LIMIT and have no management permissions.
# Bootstrap the first administrator with `tindra users create` before enabling SSO.
# Configuring OAUTH_REDIRECT_BASE or any provider credentials requires SSO,
# even if provider discovery fails or configuration is incomplete. Local password
# login, password invitation acceptance, and password-reset redemption are disabled.
# Recover local MFA through `tindra users disable-mfa <email>` if necessary.
# Remove all SSO configuration and restart to intentionally restore local login.
# Set OAUTH_REDIRECT_BASE for SSO redirects. Callback URL pattern:
# {OAUTH_REDIRECT_BASE}/api/auth/{provider}/callback
# OAUTH_REDIRECT_BASE=https://tindra.example.com

# Generic OIDC (Zitadel, Keycloak, Authentik, Cloudflare Access, ...)
# OIDC_ISSUER_URL=https://auth.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=oidc

# Zitadel
# ZITADEL_ISSUER_URL=https://auth.example.com
# ZITADEL_CLIENT_ID=
# ZITADEL_CLIENT_SECRET=

# Auth0
# AUTH0_DOMAIN=myapp.us.auth0.com
# AUTH0_CLIENT_ID=
# AUTH0_CLIENT_SECRET=

# Google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Microsoft / Azure AD (MICROSOFT_TENANT: common | organizations | consumers | <tenant-id>)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common

# GitHub
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
